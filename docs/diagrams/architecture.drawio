<mxfile host="app.diagrams.net" agent="Local source-based diagram generator" type="device"><diagram id="star-hub-and-spoke" name="Star hub and spoke"><mxGraphModel page="1" pageScale="1" pageWidth="1900" pageHeight="1640"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" value="&lt;b&gt;Azure network — star hub and spoke&lt;/b&gt;" vertex="1" style="text;html=1;align=left;fontSize=32;fontFamily=Arial;"><mxGeometry as="geometry" x="30" y="42" width="1840" height="44" /></mxCell><mxCell id="rim" parent="1" value="" vertex="1" style="ellipse;fillColor=none;strokeColor=#dde3eb;strokeWidth=2.5;connectable=0;"><mxGeometry as="geometry" x="390" y="230" width="1120" height="1120" /></mxCell><mxCell id="prod" parent="1" value="Production subscription" vertex="1" style="rounded=1;html=1;align=left;verticalAlign=top;spacing=14;fillColor=none;strokeColor=#6c8ebf;dashed=1;fontSize=14;fontStyle=1;fontFamily=Arial;container=1;collapsible=0;"><mxGeometry as="geometry" x="710" y="110" width="480" height="1410" /></mxCell><mxCell id="hub-sub" parent="1" value="Hub subscription" vertex="1" style="rounded=1;html=1;align=left;verticalAlign=top;spacing=14;fillColor=none;strokeColor=#9673a6;dashed=1;fontSize=14;fontStyle=1;fontFamily=Arial;container=1;collapsible=0;"><mxGeometry as="geometry" x="220" y="350" width="480" height="900" /></mxCell><mxCell id="np-sub" parent="1" value="Nonproduction subscription" vertex="1" style="rounded=1;html=1;align=left;verticalAlign=top;spacing=14;fillColor=none;strokeColor=#d79b00;dashed=1;fontSize=14;fontStyle=1;fontFamily=Arial;container=1;collapsible=0;"><mxGeometry as="geometry" x="1200" y="350" width="480" height="900" /></mxCell><mxCell id="app-services" parent="prod" value="&lt;div style=&quot;font-size:10.5px;font-weight:bold;line-height:18px&quot;&gt;SEPARATE APPLICATION / DATA / WEB / DOCUMENT RGs&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;line-height:22px;margin-top:9px&quot;&gt;Application services&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:19px;margin-top:9px&quot;&gt;Functions API, Azure SQL, Blob Storage and Static Web&lt;br/&gt;Apps. The API integrates with the application spoke.&lt;/div&gt;" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontColor=#20384f;fontFamily=Arial;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.8;"><mxGeometry as="geometry" x="20.0" y="30.0" width="440" height="180" /></mxCell><mxCell id="guide-app-services" parent="1" source="hub-vnet" target="app-services" value="" edge="1" style="edgeStyle=none;html=1;strokeColor=#c9d2de;dashed=1;endArrow=none;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="np-network" parent="np-sub" value="&lt;div style=&quot;font-size:10.5px;font-weight:bold;line-height:18px&quot;&gt;NONPRODUCTION NETWORK RG&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;line-height:22px;margin-top:9px&quot;&gt;Test application VNet&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:19px;margin-top:9px&quot;&gt;10.20.0.0/16&lt;br/&gt;Separate integration and endpoint subnets. No production&lt;br/&gt;peering is shown.&lt;/div&gt;" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontColor=#20384f;fontFamily=Arial;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.8;"><mxGeometry as="geometry" x="14.97" y="70.0" width="440" height="180" /></mxCell><mxCell id="guide-np-network" parent="1" source="hub-vnet" target="np-network" value="" edge="1" style="edgeStyle=none;html=1;strokeColor=#c9d2de;dashed=1;endArrow=none;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="np-shared" parent="np-sub" value="&lt;div style=&quot;font-size:10.5px;font-weight:bold;line-height:18px&quot;&gt;SEPARATE SHARED-DEPENDENCY RGs&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;line-height:22px;margin-top:9px&quot;&gt;Runtime dependencies&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:19px;margin-top:9px&quot;&gt;Selected registries, credentials, state and&lt;br/&gt;communication services support other environments too.&lt;/div&gt;" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontColor=#20384f;fontFamily=Arial;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.8;"><mxGeometry as="geometry" x="14.97" y="630.0" width="440" height="180" /></mxCell><mxCell id="guide-np-shared" parent="1" source="hub-vnet" target="np-shared" value="" edge="1" style="edgeStyle=none;html=1;strokeColor=#c9d2de;dashed=1;endArrow=none;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="spoke" parent="prod" value="&lt;div style=&quot;font-size:10.5px;font-weight:bold;line-height:18px&quot;&gt;PRODUCTION CONNECTIVITY RG&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;line-height:22px;margin-top:9px&quot;&gt;Application spoke VNet&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:19px;margin-top:9px&quot;&gt;10.40.0.0/16&lt;br/&gt;Integration subnet: 10.40.1.0/24&lt;br/&gt;Endpoint subnet: 10.40.2.0/24&lt;br/&gt;The documented peered spoke.&lt;/div&gt;" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontColor=#20384f;fontFamily=Arial;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.8;"><mxGeometry as="geometry" x="20.0" y="1130.0" width="440" height="220" /></mxCell><mxCell id="peer-spoke" parent="1" source="hub-vnet" target="spoke" value="Two-way VNet peering" edge="1" style="edgeStyle=none;html=1;strokeColor=#245b91;strokeWidth=4.5;startArrow=block;endArrow=block;fontSize=15;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="engineering" parent="hub-sub" value="&lt;div style=&quot;font-size:10.5px;font-weight:bold;line-height:18px&quot;&gt;ENGINEERING NETWORK / PORTAL RGs&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;line-height:22px;margin-top:9px&quot;&gt;Engineering VNet + portal&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:19px;margin-top:9px&quot;&gt;10.50.0.0/20&lt;br/&gt;Backstage VM subnet: 10.50.2.64/27&lt;br/&gt;Separate network; no production peering is shown.&lt;/div&gt;" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontColor=#20384f;fontFamily=Arial;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.8;"><mxGeometry as="geometry" x="25.03" y="630.0" width="440" height="180" /></mxCell><mxCell id="guide-engineering" parent="1" source="hub-vnet" target="engineering" value="" edge="1" style="edgeStyle=none;html=1;strokeColor=#c9d2de;dashed=1;endArrow=none;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="monitoring" parent="hub-sub" value="&lt;div style=&quot;font-size:10.5px;font-weight:bold;line-height:18px&quot;&gt;MONITORING / SECURITY / REGISTRY RGs&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;line-height:22px;margin-top:9px&quot;&gt;Shared engineering services&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:19px;margin-top:9px&quot;&gt;Operations workspace, separate Sentinel security&lt;br/&gt;workspace and engineering registry. These are outside&lt;br/&gt;the VNets.&lt;/div&gt;" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontColor=#20384f;fontFamily=Arial;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.8;"><mxGeometry as="geometry" x="25.03" y="70.0" width="440" height="180" /></mxCell><mxCell id="guide-monitoring" parent="1" source="hub-vnet" target="monitoring" value="" edge="1" style="edgeStyle=none;html=1;strokeColor=#c9d2de;dashed=1;endArrow=none;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hub-vnet" parent="prod" value="&lt;b style=&quot;font-size:20px&quot;&gt;Connectivity hub VNet&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;10.30.0.0/16&lt;br/&gt;NETWORK HUB&lt;br/&gt;Reserved Firewall / DNS / gateway&lt;br/&gt;services remain off.&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PRODUCTION CONNECTIVITY RG&lt;/span&gt;" vertex="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#ffffff;fontFamily=Arial;fontSize=14;spacing=18;fillColor=#234c72;strokeColor=#173b5b;strokeWidth=3;"><mxGeometry as="geometry" x="80" y="520" width="320" height="320" /></mxCell><mxCell id="notes" parent="1" value="Blue double arrow = documented VNet peering. Gray dotted rays and rim = visual guides only, not traffic paths or peerings.&lt;br/&gt;The center is the production connectivity hub VNet. Engineering and nonproduction are separate networks; no peering to them is implied.&lt;br/&gt;Subscription outlines show ownership. The Production connectivity hub and the separate Hub subscription are different concepts.&lt;br/&gt;Peering does not guarantee application access or automatic transit. Routes, DNS, security rules and service permissions still apply. Selected documented topology; not a fresh live inventory." vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;"><mxGeometry as="geometry" x="30" y="1530" width="1840" height="105" /></mxCell><mxCell id="purpose-icon-app-services" parent="app-services" value="" vertex="1" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2240%22%20height%3D%2240%22%20viewBox%3D%220%200%2040%2040%22%3E%3Crect%20x%3D%221%22%20y%3D%221%22%20width%3D%2238%22%20height%3D%2238%22%20rx%3D%228%22%20fill%3D%22white%22%20stroke%3D%22%23315f8a%22%20stroke-opacity%3D%220.3%22%2F%3E%3Cg%20transform%3D%22translate%288%208%29%22%20fill%3D%22none%22%20stroke%3D%22%23315f8a%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M6%2020a5%205%200%201%201%200-10%207%207%200%200%201%2013-2%206%